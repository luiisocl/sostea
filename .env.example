# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase.
# No painel do Supabase: Project Settings > API Keys (e Data API para a URL).
# NUNCA coloque a chave "secret" / "service_role" aqui.

# URL do projeto. Ex.: https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Chave pública ("Publishable key", começa com sb_publishable_...)
# Em painéis antigos ela se chama "anon public".
SUPABASE_PUBLISHABLE_KEY=
